# =============================================================================
# RepoMind — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider
# Supported: groq (default) | openai | ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq — FREE, no GPU needed, ultra fast (recommended)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_...
# Available models:
#   llama-3.3-70b-versatile   ← best quality (recommended)
#   llama-3.1-8b-instant      ← fastest, lighter
#   deepseek-r1-distill-llama-70b ← reasoning tasks
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional — paid)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama — local inference, no API key needed (needs good hardware)
# Run with: docker compose --profile ollama up
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# Vector Database
# Supported: chroma
# -----------------------------------------------------------------------------
VECTOR_DB=chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# -----------------------------------------------------------------------------
# Graph Backend
# Supported: networkx (default) | neo4j
# -----------------------------------------------------------------------------
GRAPH_BACKEND=networkx

# Neo4j (optional — only if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development
